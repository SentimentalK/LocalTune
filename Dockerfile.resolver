# syntax=docker/dockerfile:1
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY workers/playlist-resolver/package.json ./
COPY workers/playlist-resolver/server.mjs ./
COPY workers/playlist-resolver/src ./src
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8787/api/healthz || exit 1
CMD ["node", "server.mjs"]
